{
  "name": "chess-3d-pvp",
  "private": true,
  "version": "0.1.0",
  "description": "3D Chess PvP Platform with matchmaking, leaderboard, and admin panel",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter server test:integration",
    "format": "prettier --write .",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
